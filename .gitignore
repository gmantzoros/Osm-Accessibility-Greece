# Allowlist: source, tests, configuration, documentation and corrected summary
# results only. Inputs (PBF/GISCO), provider caches, audit annotations, the
# manuscript and its builder, run logs/manifests (they hold local machine paths),
# JARs and dependencies stay local. git add -f bypasses this list.
/*
!/.gitignore
!/LICENSE
!/README.md

!/analysis/
/analysis/*
!/analysis/*.py

!/census/
/census/*
!/census/pom.xml
!/census/src/
/census/src/**
!/census/src/**/
!/census/src/**/*.java
!/census/src/test/resources/test_boxes.geojson

!/data/
/data/*
!/data/fetch_data.ps1
!/data/prepare_boundaries.py
!/data/profile-bvi.json
!/data/profile-bvi-permissive.json
!/data/profile-wheelchair.json
!/data/strata.json
!/data/strata_national.json
!/data/strata_test.json
!/data/SNAPSHOT.txt
!/data/greece-latest.osm.pbf.md5
!/data/greece-latest.osm.pbf.provenance.json
!/data/external/
/data/external/*
!/data/external/AUX_SNAPSHOT.txt

!/docs/
/docs/*
!/docs/*.md

!/validation/
/validation/*
!/validation/*.py
# Needs the unpublished manuscript builder / historical release packager.
/validation/test_manuscript_claims.py
/validation/test_release_package.py
/validation/test_release_version_guard.py

# Corrected (conditional-2026-10-09) summary results; ODbL, see README.
!/results/
/results/*
!/results/impact/
/results/impact/*

!/results/impact/unified-conditional-2026-10-09/
/results/impact/unified-conditional-2026-10-09/*
!/results/impact/unified-conditional-2026-10-09/paper_data.json
!/results/impact/unified-conditional-2026-10-09/analysis/
!/results/impact/unified-conditional-2026-10-09/campaign/
/results/impact/unified-conditional-2026-10-09/campaign/maproulette_*
!/results/impact/unified-conditional-2026-10-09/countries/
/results/impact/unified-conditional-2026-10-09/countries/*/
!/results/impact/unified-conditional-2026-10-09/profiles/
/results/impact/unified-conditional-2026-10-09/profiles/*/
!/results/impact/unified-conditional-2026-10-09/urban/

!/results/impact/greece-full-strata-conditional-2026-10-09/
/results/impact/greece-full-strata-conditional-2026-10-09/*
!/results/impact/greece-full-strata-conditional-2026-10-09/summary.csv
!/results/impact/greece-full-strata-conditional-2026-10-09/crossing_metrics.csv
!/results/impact/greece-full-strata-conditional-2026-10-09/feasibility.csv
!/results/impact/greece-full-strata-conditional-2026-10-09/feasibility_global.csv
!/results/impact/greece-full-strata-conditional-2026-10-09/spatial_coverage.csv
!/results/impact/greece-full-strata-conditional-2026-10-09/edit_targets.csv
!/results/impact/greece-full-strata-conditional-2026-10-09/edit_targets_efficiency.csv
!/results/impact/greece-full-strata-conditional-2026-10-09/edit_targets_length_baseline.csv
!/results/impact/greece-full-strata-conditional-2026-10-09/edit_targets_summary.csv

# Defence in depth for temporary, installed, secret- or path-bearing files.
**/__pycache__/
**/node_modules/
**/target/
**/secrets/
**/.env*
**/*.pyc
**/*.jar
**/*.zip
**/run.log
**/run_manifest.json
